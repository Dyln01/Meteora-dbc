{
  "name": "dbc-forge",
  "version": "0.1.0",
  "description": "Offline simulation, validation and presets for Meteora Dynamic Bonding Curve (DBC) configs",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dbc-forge": "dist/src/cli.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/dbc.test.js dist/test/deploy.test.js dist/test/feed.test.js dist/test/migrate.test.js dist/test/reserve.test.js dist/test/wallet.test.js",
    "presets": "node dist/src/cli.js presets",
    "simulate": "node dist/src/cli.js simulate"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.13",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.5"
  }
}
